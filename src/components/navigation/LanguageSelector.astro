---
import { navLanguages } from "@/data/navigation";

interface Props {
	languages?: typeof navLanguages;
}

const { languages = navLanguages } = Astro.props;
---

<!-- Selector simple de idioma. El comportamiento JS vive en SiteNav para compartir estado. -->
<div class="relative" data-language-menu>
	<button
		class="flex h-10 items-center gap-1.5 rounded-full px-3 text-[11px] font-bold uppercase tracking-[0.18em] text-deep-emerald transition-colors hover:bg-deep-emerald/10"
		type="button"
		aria-label="Change language"
		aria-expanded="false"
		data-language-toggle
	>
		<svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none">
			<path
				d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z"
				stroke="currentColor"
				stroke-width="1.8"></path>
			<path
				d="M3.6 9h16.8M3.6 15h16.8M12 3c2.1 2.4 3.1 5.4 3.1 9s-1 6.6-3.1 9c-2.1-2.4-3.1-5.4-3.1-9S9.9 5.4 12 3Z"
				stroke="currentColor"
				stroke-width="1.8"
				stroke-linecap="round"></path>
		</svg>
		<span data-language-current>EN</span>
	</button>

	<div
		class="invisible absolute right-0 top-12 min-w-32 translate-y-1 rounded-lg border border-deep-emerald/10 bg-white/95 p-1 opacity-0 shadow-xl shadow-deep-emerald/10 backdrop-blur transition-all"
		data-language-options
	>
		{
			languages.map((language) => (
				<button
					class="flex w-full items-center justify-between rounded-md px-3 py-2 text-left text-xs font-bold uppercase tracking-[0.16em] text-secondary transition-colors hover:bg-deep-emerald/10 hover:text-deep-emerald"
					type="button"
					data-language-option={language.code}
				>
					{language.label}
				</button>
			))
		}
	</div>
</div>
