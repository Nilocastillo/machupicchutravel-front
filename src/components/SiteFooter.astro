---
const currentYear = new Date().getFullYear();
const whatsappUrl = "https://wa.me/51977777777";
const proposalUrl = "mailto:info@machupicchu.com.pe";

const footerColumns = [
	{
		title: "Machu Picchu Essentials",
		links: [
			"Machu Picchu Trip",
			"Tours",
			"Peru",
			"Tour",
			"Tickets",
			"Hotel",
			"News",
			"Inca Machu Picchu",
		],
	},
	{
		title: "Plan Your Visit",
		links: [
			"All Inclusive Tours",
			"Cusco to Machu Picchu",
			"Travel to Machu Picchu",
			"How visit Machu Picchu",
			"Inca trail to Machu Picchu",
			"Tours to Machu Picchu from Cusco",
			"Who built the Machu Picchu",
			"Where is Machu Picchu",
			"History of Machu Picchu",
		],
	},
	{
		title: "Resources & Partners",
		links: [
			"Perurails",
			"Mountain Rainbow Peru",
			"Huayna Picchu",
			"The Inca Trail",
			"Salkantaytrek",
			"Hiram Bingham",
			"Mountains in Peru",
			"Machu Picchu Hike",
		],
	},
	{
		title: "Explore Peru",
		links: [
			"Peru Tours",
			"Lima Tours",
			"Machu Picchu Mountain",
			"Machu Picchu Reservations",
			"Belmond Sanctuary Lodge",
			"Peru Tourism",
			"Huchuy Picchu",
			"Peru Vacation",
		],
	},
];
---

<section class="relative mt-16 overflow-hidden bg-[#101500] px-5 py-16 text-center sm:mt-20 sm:px-8 lg:mt-24 lg:py-20">
	<div class="mx-auto max-w-2xl">
		<span class="mb-2 block font-display text-xl italic text-action-gold">
			Begin Your Legacy
		</span>
		<h2 class="mb-6 text-3xl font-bold tracking-tight text-white lg:text-4xl">
			Ready for the Adventure?
		</h2>
		<div class="flex flex-col justify-center gap-4 sm:flex-row">
			<a
				class="group inline-flex items-center justify-center gap-2 rounded-lg bg-[#25D366] px-8 py-4 text-[11px] font-bold uppercase tracking-widest text-white shadow-[0_16px_40px_rgba(37,211,102,0.22)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#1ebe5d] hover:shadow-[0_22px_55px_rgba(37,211,102,0.32)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
				href={whatsappUrl}
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg class="size-4 fill-current transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.522-2.961-2.638-.087-.117-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217s.231.001.332.005c.109.004.258-.041.404.311.145.355.491 1.2.535 1.288.044.088.072.191.014.306-.058.116-.087.188-.174.289-.087.101-.182.226-.26.303-.087.087-.177.182-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z" />
				</svg>
				WhatsApp Inquiry
			</a>
			<a
				class="inline-flex items-center justify-center gap-2 rounded-lg border border-action-gold/25 bg-white/10 px-8 py-4 text-[11px] font-bold uppercase tracking-widest text-white transition-all hover:border-action-gold/60 hover:bg-action-gold/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-action-gold"
				href={proposalUrl}
			>
				<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M4 6h16v12H4z" />
					<path d="m4 7 8 6 8-6" />
				</svg>
				Request Proposal
			</a>
		</div>
	</div>
</section>

<footer class="bg-[#101500] px-5 pb-10 pt-16 text-white sm:px-8">
	<div class="mx-auto max-w-container-max">
		<div class="mb-16 grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-5">
			<div class="flex flex-col gap-6">
				<span class="font-display text-2xl font-extrabold tracking-tight text-white">
					Machu Picchu Travel
				</span>

				<div class="space-y-4">
					<div class="flex items-start gap-3">
						<svg class="mt-0.5 size-4 shrink-0 text-action-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M12 21s7-5.1 7-12a7 7 0 0 0-14 0c0 6.9 7 12 7 12Z" />
							<circle cx="12" cy="9" r="2.5" />
						</svg>
						<p class="text-xs leading-relaxed text-white/65">
							Jr. Jose Santos Chocano G-5 Urb. Santa Monica, Cusco
						</p>
					</div>

					<div class="flex items-start gap-3">
						<svg class="mt-0.5 size-4 shrink-0 text-action-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M4 6h16v12H4z" />
							<path d="m4 7 8 6 8-6" />
						</svg>
						<div class="flex flex-col gap-1">
							<a class="text-xs text-white/65 transition-colors hover:text-action-gold" href="mailto:info@machupicchu.com.pe">
								info@machupicchu.com.pe
							</a>
							<a class="text-xs text-white/65 transition-colors hover:text-action-gold" href="mailto:mapitravel@hotmail.com">
								mapitravel@hotmail.com
							</a>
						</div>
					</div>

					<div class="flex items-start gap-3">
						<svg class="mt-0.5 size-4 shrink-0 text-action-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.77.63 2.6a2 2 0 0 1-.45 2.11L8.1 9.62a16 16 0 0 0 6.28 6.28l1.19-1.19a2 2 0 0 1 2.11-.45c.83.3 1.7.51 2.6.63A2 2 0 0 1 22 16.92Z" />
						</svg>
						<a class="text-xs text-white/65 transition-colors hover:text-action-gold" href="tel:+51977777777">
							+51 977 777 777
						</a>
					</div>

					<a
						class="group mt-2 inline-flex w-fit items-center gap-2 rounded-lg bg-[#25D366] px-4 py-2 text-[10px] font-bold uppercase tracking-widest text-white shadow-[0_12px_30px_rgba(37,211,102,0.2)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#1ebe5d] hover:shadow-[0_18px_42px_rgba(37,211,102,0.3)]"
						href={whatsappUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						<svg class="size-3.5 fill-current transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.522-2.961-2.638-.087-.117-.708-.941-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217s.231.001.332.005c.109.004.258-.041.404.311.145.355.491 1.2.535 1.288.044.088.072.191.014.306-.058.116-.087.188-.174.289-.087.101-.182.226-.26.303-.087.087-.177.182-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.274.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.1.824z" />
						</svg>
						WhatsApp Contact
					</a>
				</div>
			</div>

			{footerColumns.map((column) => (
				<div>
					<h5 class="mb-6 text-[10px] font-black uppercase tracking-[0.2em] text-action-gold">
						{column.title}
					</h5>
					<nav class="flex flex-col gap-3" aria-label={column.title}>
						{column.links.map((link) => (
							<a class="text-xs leading-relaxed text-white/60 transition-colors hover:text-action-gold" href="#">
								{link}
							</a>
						))}
					</nav>
				</div>
			))}
		</div>

		<div class="relative flex flex-col items-center justify-between gap-6 pt-8 md:flex-row">
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-action-gold/30 to-transparent"
			/>
			<div class="flex items-center gap-4">
				<a class="flex size-9 items-center justify-center rounded-full border border-white/10 bg-white/10 text-action-gold transition-all hover:bg-action-gold hover:text-[#101500]" href="#" aria-label="YouTube">
					<svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M21.58 7.19a2.6 2.6 0 0 0-1.83-1.84C18.13 4.92 12 4.92 12 4.92s-6.13 0-7.75.43a2.6 2.6 0 0 0-1.83 1.84A27.1 27.1 0 0 0 2 12a27.1 27.1 0 0 0 .42 4.81 2.6 2.6 0 0 0 1.83 1.84c1.62.43 7.75.43 7.75.43s6.13 0 7.75-.43a2.6 2.6 0 0 0 1.83-1.84A27.1 27.1 0 0 0 22 12a27.1 27.1 0 0 0-.42-4.81ZM10 15.08V8.92L15.2 12 10 15.08Z" />
					</svg>
				</a>
				<a class="flex size-9 items-center justify-center rounded-full border border-white/10 bg-white/10 text-action-gold transition-all hover:bg-action-gold hover:text-[#101500]" href="#" aria-label="Facebook">
					<svg class="size-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M14.2 8.35V6.9c0-.7.46-.86.78-.86h1.98V3.02L14.23 3c-3.03 0-3.72 2.27-3.72 3.72v1.63H8v3.1h2.51V21h3.1v-9.55h2.64l.35-3.1h-2.4Z" />
					</svg>
				</a>
				<a class="flex size-9 items-center justify-center rounded-full border border-white/10 bg-white/10 text-action-gold transition-all hover:bg-action-gold hover:text-[#101500]" href="#" aria-label="Instagram">
					<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<rect x="4" y="4" width="16" height="16" rx="4" />
						<circle cx="12" cy="12" r="3.5" />
						<path d="M16.8 7.2h.01" />
					</svg>
				</a>
			</div>

			<div class="flex flex-col items-center gap-5 md:flex-row md:gap-6">
				<div class="flex gap-6 text-[9px] font-bold uppercase tracking-widest text-white/55">
					<a class="transition-colors hover:text-action-gold" href="#">Privacy Policy</a>
					<a class="transition-colors hover:text-action-gold" href="#">Terms of Service</a>
				</div>
				<p class="text-center text-[9px] font-black uppercase tracking-[0.2em] text-white/35">
					&copy; {currentYear} Machu Picchu Travel &middot; Bespoke Andean Journeys
				</p>
			</div>
		</div>
	</div>
</footer>
