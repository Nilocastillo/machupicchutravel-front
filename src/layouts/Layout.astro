---
import { Font } from "astro:assets";
import SiteNav from "@/components/SiteNav.astro";
import "@/styles/global.css";
import type { StrapiTourCategory } from "@/data/strapi";

interface Props {
	lang?: string;
	tourCategories?: StrapiTourCategory[];
}

const { lang = "en", tourCategories = [] } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<Font cssVariable="--font-inter" preload />
		<Font cssVariable="--font-playfair-display" />
		<title>Machu Picchu Travel</title>
	</head>
	<body>
		<SiteNav lang={lang} tourCategories={tourCategories} />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
